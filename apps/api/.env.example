# Environment Variables for GameHub API
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Neon Serverless PostgreSQL - us-east-2 Ohio)
# 1. Connection pooling URL (usada pela aplicação Node.js / Express):
DATABASE_URL="postgresql://gamehub-db_owner:<SUA_SENHA>@ep-plain-hall-aysvw52r-pooler.c-5.us-east-2.aws.neon.tech/gamehub-db?sslmode=require"
# 2. Direct connection URL (usada para migrations e npx prisma db push):
DIRECT_URL="postgresql://gamehub-db_owner:<SUA_SENHA>@ep-plain-hall-aysvw52r.c-5.us-east-2.aws.neon.tech/gamehub-db?sslmode=require"

# JWT Authentication Secret Key
JWT_SECRET="your_secure_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Neon S3-Compatible Storage (para upload de avatars / assets no futuro)
AWS_ENDPOINT_URL_S3="https://br-ancient-heart-ayamcefd.storage.c-5.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="<generated when you copy>"
AWS_SECRET_ACCESS_KEY="<generated when you copy>"
AWS_REGION="us-east-2"

# Guess the Flag (GTF) RestCountries API Integration (v5)
REST_COUNTRIES_API_URL=https://api.restcountries.com/countries/v5
REST_COUNTRIES_API_KEY=your_private_api_key_here

