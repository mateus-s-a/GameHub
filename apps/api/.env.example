# Environment Variables for GameHub API
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Neon Serverless PostgreSQL)
# Example: postgresql://user:password@ep-falling-base-22718215.us-east-2.aws.neon.tech/gamehub-db?sslmode=require
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT Authentication Secret Key
JWT_SECRET="your_secure_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Guess the Flag (GTF) RestCountries API Integration (v5)
REST_COUNTRIES_API_URL=https://api.restcountries.com/countries/v5
REST_COUNTRIES_API_KEY=your_private_api_key_here
